{
    "multipart": [
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/center"
            },
            "when": {
                "north": "false",
                "east": "false",
                "south": "false",
                "west": "false",
                "up": "false",
                "down": "false"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch"
            },
            "when": {
                "north": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch",
                "y": 90
            },
            "when": {
                "east": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch",
                "y": 180
            },
            "when": {
                "south": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch",
                "y": 270
            },
            "when": {
                "west": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch",
                "x": 270
            },
            "when": {
                "up": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/branch",
                "x": 90
            },
            "when": {
                "down": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button"
            },
            "when": {
                "facing": "north",
                "pressed": "false"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button",
                "y": 90
            },
            "when": {
                "facing": "east",
                "pressed": "false"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button",
                "y": 180
            },
            "when": {
                "facing": "south",
                "pressed": "false"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button",
                "y": 270
            },
            "when": {
                "facing": "west",
                "pressed": "false"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button_pressed"
            },
            "when": {
                "facing": "north",
                "pressed": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button_pressed",
                "y": 90
            },
            "when": {
                "facing": "east",
                "pressed": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button_pressed",
                "y": 180
            },
            "when": {
                "facing": "south",
                "pressed": "true"
            }
        },
        {
            "apply": {
                "model": "symbols_n_signs:block/sign_post/fixture/button_pressed",
                "y": 270
            },
            "when": {
                "facing": "west",
                "pressed": "true"
            }
        }
    ]
}
